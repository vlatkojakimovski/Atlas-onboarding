{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=AtlasOnboarding;User Id=sa;Password=Local_Dev_Password_1;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Markets": {
    "MA": {
      "CountryName": "Market A",
      "NationalIdPattern": "^\\d{13}$",
      "NationalIdDescription": "13 digits",
      "NationalIdExample": "9103042345678",
      "RequiresBranchActivation": false,
      "IsActive": true
    },
    "MB": {
      "CountryName": "Market B",
      "NationalIdPattern": "^\\d{13}$",
      "NationalIdDescription": "13 digits (YYMMDDGSSSSCC)",
      "NationalIdExample": "9103042345678",
      "RequiresBranchActivation": false,
      "IsActive": true
    },
    "MC": {
      "CountryName": "Market C",
      "NationalIdPattern": "^[A-Z0-9]{8}[A-Z]$",
      "NationalIdDescription": "Unified Citizen ID — 9 characters, alphanumeric, letter in position 9",
      "NationalIdExample": "AB12345Z",
      "RequiresBranchActivation": false,
      "IsActive": true
    },
    "MD": {
      "CountryName": "Market D",
      "NationalIdPattern": "^\\d{10}$",
      "NationalIdDescription": "10 digits (Citizen Number)",
      "NationalIdExample": "1234567890",
      "RequiresBranchActivation": true,
      "IsActive": true
    },
    "ME": {
      "CountryName": "Market E",
      "NationalIdPattern": "^\\d{10}$",
      "NationalIdDescription": "10 digits (Civil Number with check digit)",
      "NationalIdExample": "1234567890",
      "RequiresBranchActivation": false,
      "IsActive": true
    },
    "MF": {
      "CountryName": "Market F",
      "NationalIdPattern": "^[A-Z]\\d{7}$",
      "NationalIdDescription": "1 letter + 7 digits (Passport accepted for non-citizens)",
      "NationalIdExample": "A1234567",
      "RequiresBranchActivation": false,
      "IsActive": true
    }
  },
  "ExternalServices": {
    "IdentityVerification": {
      "TimeoutSeconds": 10,
      "RetryCount": 3
    },
    "SanctionsScreening": {
      "TimeoutSeconds": 10,
      "RetryCount": 3
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
